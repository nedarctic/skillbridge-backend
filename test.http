# Register user
POST http://localhost:8000/api/v1/dj-rest-auth/registration/
Content-Type: application/json

{
  "email": "amina.mwangi@example.com",
  "password1": "StrongPass123!",
  "password2": "StrongPass123!",
  "first_name": "Amina",
  "last_name": "Mwangi"
}

###
# Login to get token (replace with your auth endpoint if different)
POST http://localhost:8000/api/v1/token/
Content-Type: application/json

{
  "email": "amina.mwangi@example.com",
  "password": "StrongPass123!"
}

###
# Create profile (multipart/form-data with image). 
# Replace {{TOKEN}} with the token returned by the login response (e.g. "Token abc...").
