# Register user
POST http://localhost:8000/api/v1/dj-rest-auth/registration/
Content-Type: application/json

{
  "email": "linda.kariuki@example.com",
  "password1": "StrongPass123!",
  "password2": "StrongPass123!",
  "first_name": "Linda",
  "last_name": "Kariuki"
}

###
# Login to get token (replace with your auth endpoint if different)
POST http://localhost:8000/api/v1/token/
Content-Type: application/json

{
  "email": "linda.kariuki@example.com",
  "password": "StrongPass123!"
}

###
# Create profile (multipart/form-data with image). 
# Replace {{TOKEN}} with the token returned by the login response (e.g. "Token abc...").
POST http://localhost:8000/api/v1/profiles/ HTTP/1.1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzYzMzEyMTczLCJpYXQiOjE3NjMzMTEyNzMsImp0aSI6IjViODYyNTUxZDBkNTQ2NDZiMmFjM2Y5NTVhNGQ1Y2Y1IiwidXNlcl9pZCI6IjIifQ.uIvCpIXqPLG7Hl5hfxxO2-6ZhKXYAgLt0GW1bC3fxxA
